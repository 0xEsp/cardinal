# Clave de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Modelo por defecto para los agentes (id de OpenRouter)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Modelos disponibles en el selector del dashboard (separados por coma)
MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4.1,google/gemini-2.5-pro,deepseek/deepseek-v4.1-flash,openai/gpt-5.6-luna

# Puerto del servidor
PORT=4400

# Imagen que usará Docker Compose en la Raspberry.
# El script de build genera esta etiqueta por defecto.
PRODUCT_OS_IMAGE=gotty-product-os:raspberry

# Ruta persistente de la SQLite en el host.
# Si se deja comentada, Compose usa ./data relativo a este proyecto.
# En la Raspberry configura la ruta del volumen existente:
# PRODUCT_OS_DATA_DIR=/home/0xEsp/justgame-product-os/data

# Si es "true", tras terminar un agente se hace commit+push automático del workspace
AUTO_PUSH=false

# Credenciales para git pull/push por HTTPS (necesario en Docker/Raspberry,
# donde no hay credential helper). Crea un fine-grained token en
# https://github.com/settings/personal-access-tokens con permiso Contents:write
# sobre el repo gotty-labs/product-os.
GIT_USERNAME=tu-usuario-de-github
GIT_TOKEN=github_pat_...
