# Proveedores de IA: lo normal es configurarlos desde la pestaña IA del
# dashboard (API key de OpenRouter, cuenta de ChatGPT para Codex y token de
# Claude). Estas variables son una alternativa opcional.

# Clave de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Modelo por defecto de OpenRouter
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Modelos de reserva si el catálogo en vivo de OpenRouter no responde
MODELS=anthropic/claude-sonnet-4.5,deepseek/deepseek-v4.1-flash

# Token de `claude setup-token` para usar tu suscripción Pro/Max
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# "false" desactiva la actualización diaria de los CLIs de Codex y Claude
# CLI_AUTO_UPDATE=true

# Puente de Paper (diseño). Corre en el Mac con la app de Paper abierta:
#   node scripts/paper-bridge/paper-bridge.mjs   → levántalo al diseñar (Ctrl+C para cerrar); muestra URL y token
# Lo normal es configurarlo en la pestaña IA; estas variables son alternativa.
# PAPER_BRIDGE_URL=http://<ip-del-mac>:4410/mcp
# PAPER_BRIDGE_TOKEN=...
# PAPER_FILE_ID=...

# Moki (diseño, alternativa a Paper). Servidor propio siempre encendido en la
# red local con MCP por HTTP: no necesita puente. Lo normal es configurarlo en
# la pestaña IA; estas variables son alternativa.
# MOKI_URL=http://<ip-del-servidor-de-moki>:7410/mcp
# MOKI_TOKEN=...
# MOKI_FILE_ID=...

# Puerto del servidor
PORT=4400

# Imagen que usará Docker Compose en la Raspberry.
# El script de build genera esta etiqueta por defecto.
PRODUCT_OS_IMAGE=gotty-product-os:raspberry

# Ruta persistente de la SQLite en el host.
# Si se deja comentada, Compose usa ./data relativo a este proyecto.
# En la Raspberry configura la ruta del volumen existente:
# PRODUCT_OS_DATA_DIR=/home/0xEsp/justgame-product-os/data

# Si es "true", tras terminar un agente se hace commit+push automático del workspace
AUTO_PUSH=false

# Credenciales para git pull/push por HTTPS (necesario en Docker/Raspberry,
# donde no hay credential helper). Crea un fine-grained token en
# https://github.com/settings/personal-access-tokens con permiso Contents:write
# sobre el repo gotty-labs/product-os.
GIT_USERNAME=tu-usuario-de-github
GIT_TOKEN=github_pat_...
